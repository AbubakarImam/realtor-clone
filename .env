# GidaListing API base URL. Points at the local backend by default — see
# ../Gida-listing-API (docker compose up, npm run start:dev). Override with
# .env.production.local (gitignored) once the API is deployed somewhere real.
REACT_APP_API_URL=http://localhost:3333

# Google OAuth Web Client ID (public — safe to commit; this is not a secret).
# Get one at console.cloud.google.com -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Web application. Must be the SAME
# client ID the backend's GOOGLE_OAUTH_CLIENT_ID is set to, or Google sign-in
# will fail token verification. Not yet configured — Google sign-in shows an
# explanatory error until this is a real value.
REACT_APP_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
